name = "ritratto-stellare-api"
main = "src/index.js"
compatibility_date = "2026-09-26"

[vars]
PAYPAL_ENV = "sandbox"
LIVE_COMMERCIAL_AUTHORIZED = "false"
PUBLIC_ORIGIN = "https://vitoperillo.github.io"
PUBLIC_PATH = "/ritratto-stellare"

[[d1_databases]]
binding = "DB"
database_name = "ritratto-stellare"
database_id = "REPLACE_AFTER_CREATE"

[[kv_namespaces]]
binding = "CACHE"
id = "REPLACE_AFTER_CREATE"
